---
// ProjectGrid.astro - Expandable project list for the bottom of the portal
import { useTranslations } from "../../i18n/ui";

const { lang = "fr" } = Astro.props;
const t = useTranslations(lang as "fr" | "en");

// Example projects data
const projects = [
  {
    name: "Sondages & Événements",
    desc: "Plateforme collaborative de gestion d'événements avec système de sondages intégré.",
    github: "https://github.com",
    visit: "https://example.com",
    tech: ["Next.js", "TypeScript", "SQL"]
  },
  {
    name: "YT-Alibi",
    desc: "Un jeu expérimental amélioré par intelligence artificielle pour une expérience narrative unique.",
    github: "https://github.com",
    visit: "https://example.com",
    tech: ["React", "OpenAI", "Node.js"]
  },
  {
    name: "Mélangeur de fichiers",
    desc: "Outil de gestion et lecture aléatoire de fichiers audio pour les créateurs de contenu.",
    github: "https://github.com",
    visit: null, // No visit link for this one to test full width github button
    tech: ["Astro", "Web Audio API"]
  }
];
---

<div class="mt-8">
  <project-menu data-lang={lang}>
    <button
      id="toggle-projects"
      class="w-full py-4 px-6 bg-vintage-grey border-2 border-accent-amber/40 rounded-lg shadow-lg flex items-center justify-between hover:bg-vintage-grey-light hover:border-accent-amber transition-all duration-300 group cursor-pointer"
    >
      <div class="flex items-center gap-4">
        <div class="w-2 h-2 rounded-full bg-accent-amber animate-pulse"></div>
        <span class="font-slab font-bold text-xl md:text-2xl text-text-cream group-hover:text-accent-amber transition-colors">
          {t("playground.title")}
        </span>
      </div>
      <svg 
        id="chevron-icon"
        xmlns="http://www.w3.org/2000/svg" 
        class="h-6 w-6 text-accent-amber transition-transform duration-500 ease-in-out" 
        fill="none" 
        viewBox="0 0 24 24" 
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <div 
      id="projects-wrapper" 
      class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-in-out"
    >
      <div class="overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-1 mt-6">
          {projects.map((project) => (
            <div class="bg-vintage-grey border border-accent-amber/20 rounded-lg p-5 flex flex-col h-full hover:border-accent-amber/50 transition-colors group/card">
              <h4 class="text-xl font-slab font-bold text-text-cream mb-2 truncate group-hover/card:text-accent-amber transition-colors">{project.name}</h4>
              <p class="text-sm text-vintage-cream-dark font-sans mb-4 grow line-clamp-3">
                {project.desc}
              </p>
              
              <div class="flex flex-wrap gap-2 mb-5">
                {project.tech.map((tech) => (
                  <span class="text-[10px] px-2 py-0.5 bg-accent-amber/5 border border-accent-amber/20 rounded text-accent-amber/80 font-sans uppercase tracking-wider">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex gap-3 mt-auto">
                <a 
                  href={project.github} 
                  target="_blank"
                  class:list={[
                    "py-2 px-3 bg-warm-grey border border-accent-amber/30 rounded text-accent-amber text-xs font-sans font-medium text-center hover:bg-white/5 transition-all uppercase tracking-wide flex items-center justify-center gap-2",
                    !project.visit ? "w-full" : "flex-1"
                  ]}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  GitHub
                </a>
                
                {project.visit && (
                  <a 
                    href={project.visit} 
                    target="_blank"
                    class="flex-1 py-2 px-3 bg-accent-amber text-warm-grey border border-accent-amber rounded text-xs font-sans font-bold text-center hover:bg-white/5 transition-all uppercase tracking-wide flex items-center justify-center gap-2"
                  >
                    Visiter
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </project-menu>
</div>

<script>
  class ProjectMenu extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector('#toggle-projects');
      const wrapper = this.querySelector('#projects-wrapper');
      const chevron = this.querySelector('#chevron-icon');
      
      let isOpen = false;

      button?.addEventListener('click', () => {
        isOpen = !isOpen;
        
        if (isOpen) {
          wrapper?.classList.remove('grid-rows-[0fr]');
          wrapper?.classList.add('grid-rows-[1fr]');
          chevron?.classList.add('rotate-180');
          button?.classList.add('border-accent-amber');
          button?.classList.add('bg-vintage-grey-light');
        } else {
          wrapper?.classList.remove('grid-rows-[1fr]');
          wrapper?.classList.add('grid-rows-[0fr]');
          chevron?.classList.remove('rotate-180');
          button?.classList.remove('border-accent-amber');
          button?.classList.remove('bg-vintage-grey-light');
        }
      });
    }
  }

  customElements.define('project-menu', ProjectMenu);
</script>

<style>
  /* Optional: Add custom easing if needed, but Tailwind classes cover it */
</style>

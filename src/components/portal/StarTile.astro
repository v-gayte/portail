---
// StarTile - Large showcase tile for main project (6x4 grid)
import { motion } from "framer-motion";
---

<motion.div
  client:load
  data-hoverable
  whileHover={{ y: -5, scale: 1.02 }}
  transition={{ type: "spring", stiffness: 300, damping: 20 }}
  className="star-tile col-span-1 md:col-span-3 lg:col-span-5 row-span-4 bg-vintage-grey border-2 border-accent-amber/40 rounded-lg overflow-hidden relative group shadow-lg"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-accent-amber/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
  >
  </div>

  <div class="relative h-full p-6 md:p-8 flex flex-col justify-between">
    <!-- Badge "En cours" -->
    <div class="flex items-start justify-between">
      <span
        class="inline-flex items-center gap-2 px-4 py-2 bg-accent-amber/20 border border-accent-amber rounded-full text-accent-amber text-sm font-sans font-medium backdrop-blur-sm"
      >
        <span class="w-2 h-2 bg-accent-amber rounded-full animate-pulse-amber"
        ></span>
        En cours
      </span>
    </div>

    <!-- Content -->
    <div class="space-y-4">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-slab font-bold text-text-cream leading-tight"
      >
        Gestion d'Événements
        <span class="text-accent-amber">.</span>
      </h2>

      <p
        class="text-vintage-cream-dark text-base md:text-lg max-w-2xl font-sans"
      >
        Plateforme collaborative pour orchestrer des événements avec élégance.
        Architecture moderne, expérience utilisateur fluide.
      </p>

      <!-- Tech Stack -->
      <div class="flex flex-wrap gap-2 mt-4">
        {
          ["Astro", "TypeScript", "Tailwind", "Vercel"].map((tech) => (
            <span class="px-3 py-1 bg-warm-grey border border-vintage-grey-light rounded text-vintage-cream text-sm font-sans">
              {tech}
            </span>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div
      class="flex items-center gap-2 text-accent-amber font-slab text-base md:text-lg group-hover:gap-4 transition-all"
    >
      <span>Découvrir le projet</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 md:h-6 md:w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </div>
  </div>
</motion.div>

<style>
  .star-tile {
    background: linear-gradient(135deg, #252526 0%, #2f2f30 100%);
  }
</style>

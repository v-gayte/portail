---
// SocialHubTile - LinkedIn & GitHub with portrait (3x2 grid)
import { motion } from "framer-motion";
---

<motion.div
  client:load
  whileHover={{ y: -5, scale: 1.02 }}
  transition={{ type: "spring", stiffness: 300, damping: 20 }}
  className="social-tile col-span-1 md:col-span-2 row-span-2 bg-vintage-grey border-2 border-accent-amber/40 rounded-lg overflow-hidden relative group shadow-lg"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-accent-amber/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
  >
  </div>

  <div class="relative h-full p-4 md:p-6 flex items-center gap-4 md:gap-6">
    <!-- Portrait Placeholder with Warm Light Effect -->
    <div class="relative shrink-0">
      <div
        class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-gradient-to-br from-accent-amber/20 to-vintage-grey-light border-2 border-accent-amber/40 overflow-hidden"
      >
        <!-- Placeholder silhouette -->
        <div class="w-full h-full flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-12 w-12 md:h-14 md:w-14 text-accent-amber/40"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path>
          </svg>
        </div>
      </div>
      <!-- Warm glow effect -->
      <div
        class="absolute -inset-1 bg-accent-amber/20 rounded-full blur-xl -z-10"
      >
      </div>
    </div>

    <!-- Social Links -->
    <div class="flex-1 space-y-3 md:space-y-4">
      <h3 class="text-xl md:text-2xl font-slab font-bold text-text-cream">
        Restons connectés
      </h3>

      <div class="flex flex-col gap-2 md:gap-3">
        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/in/virgil-gayte"
          target="_blank"
          data-hoverable
          class="flex items-center gap-2 md:gap-3 px-3 py-1.5 md:px-4 md:py-2 bg-vintage-grey-light border border-accent-amber/20 rounded hover:border-accent-amber/60 transition-all group/link"
        >
          <svg
            class="h-4 w-4 md:h-5 md:w-5 text-accent-amber"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
            ></path>
          </svg>
          <span class="text-vintage-cream font-sans text-sm md:text-base"
            >LinkedIn</span
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3 w-3 md:h-4 md:w-4 text-accent-amber ml-auto group-hover/link:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/v-gayte"
          target="_blank"
          data-hoverable
          class="flex items-center gap-2 md:gap-3 px-3 py-1.5 md:px-4 md:py-2 bg-vintage-grey-light border border-accent-amber/20 rounded hover:border-accent-amber/60 transition-all group/link"
        >
          <svg
            class="h-4 w-4 md:h-5 md:w-5 text-accent-amber"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          <span class="text-vintage-cream font-sans text-sm md:text-base"
            >GitHub</span
          >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3 w-3 md:h-4 md:w-4 text-accent-amber ml-auto group-hover/link:translate-x-1 transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</motion.div>

<style>
  .social-tile {
    background: linear-gradient(135deg, #252526 0%, #2f2f30 100%);
  }
</style>

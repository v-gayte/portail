---
// WorkshopTile - Portfolio technique link (2x1)
import { motion } from "framer-motion";
import { useTranslations } from "../../i18n/ui";

const { lang = "fr" } = Astro.props;
const t = useTranslations(lang as "fr" | "en");
---

<a
  href={`https://portfolio.virgil-gayte.me/${lang}/`}
  data-hoverable
  class="col-span-1 md:col-span-2 row-span-1 block h-full no-underline"
>
  <motion.div
    client:load
    whileHover={{ y: -5, scale: 1.02 }}
    transition={{ type: "spring", stiffness: 300, damping: 20 }}
    className="workshop-tile h-full bg-vintage-grey border-2 border-accent-amber/40 rounded-lg overflow-hidden relative group shadow-lg"
  >
    <div
      class="absolute inset-0 bg-gradient-to-br from-accent-amber/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    >
    </div>

    <div class="relative h-full p-5 flex flex-col items-center justify-center">
      <div class="text-center space-y-2 w-full px-3">
        <h3
          class="text-2xl md:text-3xl font-slab font-bold text-text-cream truncate"
        >
          {t("workshop.title")}
        </h3>
        <p
          class="text-sm md:text-base text-vintage-cream-dark font-sans truncate"
        >
          {t("workshop.description")}
        </p>
      </div>
    </div>
  </motion.div>
</a>

<style>
  .workshop-tile {
    background: linear-gradient(135deg, #252526 0%, #2f2f30 100%);
  }
</style>

---
// FlagshipTile - Main project showcase (3x2)
import { motion } from "framer-motion";
import { useTranslations } from "../../i18n/ui";

const { lang = "fr" } = Astro.props;
const t = useTranslations(lang as "fr" | "en");
---

<motion.div
  client:load
  className="flagship-tile col-span-1 md:col-span-2 lg:col-span-3 row-span-2 bg-vintage-grey border-2 border-accent-amber/40 rounded-lg overflow-hidden relative group shadow-lg"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-accent-amber/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
  >
  </div>

  <!-- Badge "Dernière version" appears on hover -->
  <div
    class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
  >
    <span
      class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent-amber text-warm-grey text-xs font-sans font-semibold rounded-full truncate"
    >
      {t("flagship.badge")}
    </span>
  </div>

  <div class="relative h-full p-6 flex flex-col items-center justify-center">
    <div class="space-y-4 text-center max-w-2xl w-full px-4">
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-slab font-bold text-text-cream leading-tight truncate"
      >
        {t("flagship.title")}
        <span class="text-accent-amber">.</span>
      </h2>

      <p
        class="text-vintage-cream-dark text-sm md:text-base font-sans line-clamp-3"
      >
        {t("flagship.description")}
      </p>

      <!-- Tech badges -->
      <div class="flex flex-wrap gap-2 justify-center pt-2">
        {
          ["TypeScript", "Next.js", "SQL", "Tailwind CSS"].map((tech) => (
            <span class="px-3 py-1 bg-accent-amber/10 border border-accent-amber/30 rounded text-accent-amber text-xs font-sans truncate">
              {tech}
            </span>
          ))
        }
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-4 justify-center mt-6 w-full">
        <a 
          href="#" 
          class="px-5 py-2.5 rounded border-2 border-accent-amber bg-transparent text-text-cream font-sans font-semibold text-sm hover:bg-[#f5f5dc] hover:text-[#1a1a1b] hover:border-[#f5f5dc] transition-all duration-300 relative z-10"
        >
          {t("flagship.details")}
        </a>
        <a 
          href="https://eventflow.virgil-gayte.me" 
          class="px-5 py-2.5 rounded border-2 border-[#f5f5dc] bg-[#f5f5dc] text-[#1a1a1b] font-sans font-bold text-sm hover:bg-transparent hover:text-[#f5f5dc] transition-all duration-300 shadow-none flex items-center gap-2"
        >
          {t("flagship.visit")}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      </div>
    </div>
  </div>
</motion.div>

<style>
  .flagship-tile {
    background: linear-gradient(135deg, #252526 0%, #2f2f30 100%);
  }
</style>

---
// SocialFlowTile - GitHub & LinkedIn links (1x1)
import { motion } from "framer-motion";
import { useTranslations } from "../../i18n/ui";

const { lang = "fr" } = Astro.props;
const t = useTranslations(lang as "fr" | "en");
---

<motion.div
  client:load
  className="social-flow-tile col-span-1 md:col-span-2 lg:col-span-2 row-span-1 bg-vintage-grey border-2 border-accent-amber/40 rounded-lg overflow-hidden relative group shadow-lg"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-accent-amber/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
  >
  </div>

  <div
    class="relative h-full p-4 flex flex-row items-center justify-between gap-4"
  >
    <div class="w-1/3 px-2 flex flex-col justify-center">
      <h4
        class="text-lg font-slab font-bold text-text-cream text-left truncate"
      >
        {t("social.contact")}
      </h4>
    </div>

    <div class="flex gap-3 w-2/3 pr-2">
      <a
        href="https://github.com"
        target="_blank"
        class="flex-1 py-2 px-3 bg-accent-amber/10 border border-accent-amber/30 rounded text-accent-amber text-sm font-sans transition-all text-center truncate flex items-center justify-center cursor-pointer hover:bg-white/10 hover:scale-105 active:scale-95 duration-200"
      >
        GitHub
      </a>

      <a
        href="https://linkedin.com"
        target="_blank"
        class="flex-1 py-2 px-3 bg-accent-amber/10 border border-accent-amber/30 rounded text-accent-amber text-sm font-sans transition-all text-center truncate flex items-center justify-center cursor-pointer hover:bg-white/10 hover:scale-105 active:scale-95 duration-200"
      >
        LinkedIn
      </a>
    </div>
  </div>
</motion.div>

<style>
  .social-flow-tile {
    background: linear-gradient(135deg, #252526 0%, #2f2f30 100%);
  }
</style>

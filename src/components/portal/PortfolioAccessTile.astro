---
// PortfolioAccessTile - Gear animation tile (3x3 grid)
import { motion } from "framer-motion";
---

<a
  href="https://portfolio.virgil-gayte.me/fr/"
  data-hoverable
  class="col-span-1 md:col-span-2 lg:col-span-3 row-span-3 block h-full no-underline"
>
  <motion.div
    client:load
    whileHover={{ y: -5, scale: 1.02 }}
    transition={{ type: "spring", stiffness: 300, damping: 20 }}
    className="portfolio-tile h-full bg-vintage-grey border-2 border-accent-amber/40 rounded-lg overflow-hidden relative group shadow-lg"
  >
    <div
      class="absolute inset-0 bg-gradient-to-br from-accent-amber/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    >
    </div>

    <div
      class="relative h-full p-6 flex flex-col items-center justify-center gap-6"
    >
      <!-- Rotating Gear Icon -->
      <div class="relative">
        <motion.svg
          xmlns="http://www.w3.org/2000/svg"
          className="h-20 w-20 md:h-24 md:w-24 text-accent-amber"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          strokeWidth="1.5"
          whileHover={{ rotate: 360 }}
          transition={{ duration: 2, ease: "linear" }}
        >
          <path
            strokeLinecap="round"
            strokeLinejoin="round"
            d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z"
          ></path>
          <path
            strokeLinecap="round"
            strokeLinejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </motion.svg>
      </div>

      <!-- Title -->
      <div class="text-center space-y-2">
        <h3 class="text-2xl md:text-3xl font-slab font-bold text-text-cream">
          Portfolio
        </h3>
        <p class="text-vintage-cream-dark font-sans text-sm md:text-base">
          Explorez mes créations
        </p>
      </div>

      <!-- Arrow -->
      <div class="mt-auto">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6 md:h-8 md:w-8 text-accent-amber group-hover:translate-x-2 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </div>
    </div>
  </motion.div>
</a>

<style>
  .portfolio-tile {
    background: linear-gradient(135deg, #252526 0%, #2f2f30 100%);
  }
</style>

---
import MainLayout from "../../layouts/MainLayout.astro";
import FlagshipTile from "../../components/portal/FlagshipTile.astro";
import WorkshopTile from "../../components/portal/WorkshopTile.astro";
import IdentityTile from "../../components/portal/IdentityTile.astro";
import TechStackTile from "../../components/portal/TechStackTile.astro";
import SocialFlowTile from "../../components/portal/SocialFlowTile.astro";
import ProjectGrid from "../../components/portal/ProjectGrid.astro";
import CvDiskTile from "../../components/portal/CvDiskTile.astro";
import StatusTile from "../../components/portal/StatusTile.astro";
import VisitorCounterTile from "../../components/portal/VisitorCounterTile.astro";

import { useTranslations } from "../../i18n/ui";

const lang = "fr";
const t = useTranslations(lang);
---

<MainLayout
  title="Portail"
  description="Portail vintage-tech vers l'écosystème créatif de Virgil Gayte. Explorez mes projets, mon parcours et mes créations."
  lang={lang}
>
  <main
    class="min-h-screen bg-warm-grey px-8 py-12 md:px-16 md:py-16 lg:px-24 lg:py-20"
  >
    <div class="max-w-[1200px] mx-auto">
      <!-- Header -->
      <header class="mb-12 md:mb-16">
        <h1
          class="text-4xl md:text-6xl lg:text-7xl font-slab font-bold text-text-cream mb-4 leading-tight"
        >
          Portail
          <span class="text-accent-amber">.</span>
        </h1>
        <p
          class="text-lg md:text-xl text-vintage-cream-dark max-w-2xl font-sans"
        >
          Bienvenue dans mon espace. Vous pourrez y retrouver
          <br />
          mes projets, mes idées, mon parcours et des moyens de me contacter.
        </p>

        <!-- Language Selector -->
        <div class="mt-6 flex gap-3">
          <a
            href="/fr/"
            class="px-4 py-2 bg-accent-amber text-warm-grey font-sans font-semibold rounded hover:bg-vintage-amber-light transition-colors"
            data-hoverable
          >
            FR
          </a>
          <a
            href="/en/"
            class="px-4 py-2 bg-vintage-grey-light text-vintage-cream font-sans rounded hover:bg-vintage-grey border border-accent-amber/30 hover:border-accent-amber/60 transition-all"
            data-hoverable
          >
            EN
          </a>
        </div>
      </header>

      <!-- Narrative Grid - 4 columns -->
      <div
        class="narrative-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 auto-rows-[140px] gap-5 md:gap-6"
      >
        <!-- Line 1-2: Flagship (3x2) + CV (1x1) -->
        <!-- Line 2: Flagship (cont.) + TechStack (1x1) -->
        <FlagshipTile lang={lang} />
        <CvDiskTile lang={lang} />
        <TechStackTile lang={lang} />

        <!-- Line 3: Identity (2x1) + Workshop (2x1) -->
        <IdentityTile lang={lang} />
        <WorkshopTile lang={lang} />

        <!-- Line 4: Visitor (1x1) + Contact (2x1) + Status (1x1) -->
        <VisitorCounterTile lang={lang} />
        <SocialFlowTile lang={lang} />
        <StatusTile lang={lang} />
      </div>

      <!-- Projects Dropdown -->
      <ProjectGrid lang={lang} />

      <!-- Footer -->
      <footer class="mt-16 pt-8 border-t border-accent-amber/20">
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-4"
        >
          <p class="text-vintage-cream-dark text-sm font-sans">
            {t("footer.rights")}
          </p>
          <div class="flex gap-4 text-sm text-vintage-cream-dark font-sans">
            <a
              href="#"
              class="hover:text-accent-amber transition-colors"
              data-hoverable>{t("footer.legal")}</a
            >
            <span>•</span>
            <a
              href="#"
              class="hover:text-accent-amber transition-colors"
              data-hoverable>{t("footer.contact")}</a
            >
          </div>
        </div>
      </footer>
    </div>
  </main>
</MainLayout>

<style>
  /* Force uniform heights for tiles */
  .narrative-grid > * {
    min-height: 100%;
  }

  /* Ensure proper grid behavior on different screen sizes */
  @media (max-width: 768px) {
    .narrative-grid {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .narrative-grid > * {
      width: 100%;
      min-height: auto;
    }
  }
</style>

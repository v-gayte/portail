---
import MainLayout from '../../layouts/MainLayout.astro';
import BentoGrid from '../../components/ui/BentoGrid.astro';
import BentoCard from '../../components/ui/BentoCard.astro';

const lang = 'fr';
---

<MainLayout
  title="Portfolio Hub | Accueil"
  description="Découvrez mes projets, mon parcours et mes compétences"
  lang={lang}
>
  <main class="min-h-screen bg-dark-950 p-4 md:p-8 lg:p-12">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <header class="mb-12 animate-fade-in">
        <h1 class="text-5xl md:text-7xl font-bold text-white font-display mb-4 bg-gradient-to-r from-primary-400 to-accent-400 bg-clip-text text-transparent">
          Portfolio Hub
        </h1>
        <p class="text-xl text-dark-400 max-w-2xl">
          Bienvenue sur mon portfolio. Explorez mes projets, mon expérience et mes compétences.
        </p>
      </header>

      <!-- Bento Grid -->
      <BentoGrid class="animate-slide-up">
        <!-- Large Card - Latest Project -->
        <BentoCard
          variant="large"
          title="Dernier Projet"
          description="Découvrez mon projet le plus récent et les technologies utilisées"
          gradient="from-primary-600 via-primary-500 to-accent-600"
        >
          <div class="mt-auto">
            <div class="flex items-center gap-2 text-primary-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m9 18 6-6-6-6"/>
              </svg>
              <span class="font-semibold">Voir le projet</span>
            </div>
          </div>
        </BentoCard>

        <!-- Medium Card - About -->
        <BentoCard
          variant="medium"
          title="À propos"
          description="Développeur passionné par les technologies modernes et l'innovation"
          gradient="from-accent-600 to-purple-600"
        >
          <div class="mt-auto space-y-2">
            <div class="flex items-center gap-2 text-dark-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              <span class="text-sm">Fullstack Developer</span>
            </div>
          </div>
        </BentoCard>

        <!-- Small Card - Contact -->
        <BentoCard
          variant="small"
          title="Contact"
          gradient="from-emerald-600 to-teal-600"
        >
          <div class="mt-auto flex gap-3">
            <a href="mailto:contact@example.com" class="p-2 rounded-lg bg-dark-800/50 hover:bg-dark-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </a>
            <a href="https://github.com" target="_blank" class="p-2 rounded-lg bg-dark-800/50 hover:bg-dark-700 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                <path d="M9 18c-4.51 2-5-2-7-2"/>
              </svg>
            </a>
          </div>
        </BentoCard>

        <!-- Small Card - CV -->
        <BentoCard
          variant="small"
          title="Curriculum Vitae"
          gradient="from-orange-600 to-red-600"
        >
          <div class="mt-auto">
            <button class="flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-r from-orange-500 to-red-500 text-white font-semibold hover:from-orange-600 hover:to-red-600 transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" x2="12" y1="15" y2="3"/>
              </svg>
              <span class="text-sm">Télécharger</span>
            </button>
          </div>
        </BentoCard>
      </BentoGrid>
    </div>
  </main>
</MainLayout>
